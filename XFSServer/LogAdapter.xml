<?xml version="1.0" encoding="utf-8" ?>
<configuration>

  <configSections>
    <section name="log4net" type="System.Configuration.IgnoreSectionHandler" />
  </configSections>

  
  <!-- This section contains the log4net configuration settings -->
  <log4net debug="false">
    <appender name="RollingFileAppender" type="log4net.Appender.RollingFileAppender">
	  <file type="log4net.Util.PatternString" value="C:\app\Logs\XFSServer[%processid]%date{yyyy-MM-dd_hh-mm}.txt" />
      <appendToFile value="true" />
      <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
      <rollingStyle value="Composite" />
      <maxSizeRollBackups value="-1" />
      <maximumFileSize value="20MB" />
      <datePattern value=".dd" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date{dd/MM HH:mm:ss,fff} %-5p %m%n" />
      </layout>
    </appender>

    <appender name="ConsoleAppender" type="log4net.Appender.ConsoleAppender" >
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%date{dd/MM HH:mm:ss,fff} %-5p %m%n" />
      </layout>
    </appender>

    <appender name="EJConsoleAppender" type="log4net.Appender.ConsoleAppender">
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="EJ-%date{dd/MM HH:mm:ss,fff} %-5p %property{event} %property{line}%n" />
      </layout>
    </appender>


    <appender name="EJRollingFileAppender" type="log4net.Appender.RollingFileAppender">
      <file type="log4net.Util.PatternString">
        <conversionPattern value="C:\ssframeworklogs\log-%date{ yyyy.MM.dd.HH.mm.ss}-[%processid].log" />
      </file>
      <appendToFile value="true" />
      <rollingStyle value="Size" />
      <maxSizeRollBackups value="0" />
      <maximumFileSize value="10MB" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="{&quot;event&quot;:&quot;%property{event}&quot;, &quot;date&quot;:&quot;%date{ddd MMM dd HH:mm:ss zzz yyyy}&quot;, &quot;level&quot;:&quot;%level&quot;}%newline" />
      </layout>
    </appender>

    <appender name="EJRollingFullFileAppender" type="log4net.Appender.RollingFileAppender">
      <file type="log4net.Util.PatternString">
        <conversionPattern value="C:\ssframeworklogs\log-%date{ yyyy.MM.dd.HH.mm.ss}-[%processid].log" />
      </file>
      <appendToFile value="true" />
      <rollingStyle value="Size" />
      <maxSizeRollBackups value="0" />
      <maximumFileSize value="10MB" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="{&quot;event&quot;:&quot;%property{event}&quot;, &quot;date&quot;:&quot;%date{ddd MMM dd HH:mm:ss zzz yyyy}&quot;, &quot;level&quot;:&quot;%level&quot;, &quot;event_detail&quot;: %message}%newline" />
      </layout>
    </appender>


    <logger name="EJLogger" additivity="false">
      <level value="DEBUG" />

      <appender-ref ref="EJRollingFullFileAppender" />
      <appender-ref ref="EJConsoleAppender" />
    </logger>


    <!-- Setup the root category, add the appenders and set the default priority -->
    <root>
      <level value="ALL" />
      <appender-ref ref="RollingFileAppender" />
      <appender-ref ref="ConsoleAppender" />
    </root>


  </log4net>

</configuration>


