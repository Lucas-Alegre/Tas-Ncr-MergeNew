		"cambiar_estilo": function() { 
		    var estilos = ["petersen", "alt", "basic"];
		    var style = SSUtil.getSetting("style");
		    var c;
		    for(c=0; estilos[c]!=style && c<estilos.length; c++);
            SSFramework.setSetting("style", estilos[(c+1)%estilos.length]);
		    return "main";
		}
	}
