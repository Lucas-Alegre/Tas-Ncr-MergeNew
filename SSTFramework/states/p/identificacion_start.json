{
    "type": "General",

    "screens": {

        "default": {
            "update": function() {
                console.log("Reiniciando variables de sesión al iniciar identificación");
                States.storeNamedValue("no_cliente", null);
                SSUtil.setLocal("identified", false);
                States.storeNamedValue("tipo_identificacion", null);
                States.storeNamedValue("tipo_usuario", null);
                States.storeNamedValue("customer", null);
                States.storeNamedValue("origen_id", null);
                States.storeNamedValue("origen_id_type", null);
                States.storeNamedValue("customer_name", null);
                States.storeNamedValue("navegar.proxima_accion", null);
                States.storeNamedValue("data.menu_principal", { text: "" });    
            },

            "title":{
                "text": "",
            },


            "subtitle": {
                "text": "¿Cómo querés ingresar?"
            },

            "selectMenu": {
                "select1": {
                    "text": "Tarjeta de débito-y clave",
                    "event": "instruccion_tarjeta",
                },
                "select2": {
                    "text": "Documento-y clave",
                    "event": "identificacion_manual",
                },
                "select3": {
                    "text": "Documento",
                    "event": "no_cliente",
                }
            },
            "nav": {							    
                "nav0" : {
                    "text": "Salir",
					"event": "cancel",
                    "value": "cancel",
                }
            },
        },

        
    },

	"events" : {
	    include(p/chunk/event_timeout.json),

        "cancel": "p/close_salir",

        "identificacion_manual": function () {
        States.storeNamedValue("tipo_identificacion", "manual");
        States.storeNamedValue("navegar.origen_pin", "identificacion");
        return "p/identificacion_manual";
        },

        "no_cliente": function () {
        States.storeNamedValue("tipo_identificacion", "no_cliente");
        return "p/identificacion_manual_no_cliente";
        },

        "instruccion_tarjeta": function () {
            States.storeNamedValue("tipo_identificacion", "tarjeta");
            return "p/identificacion_tarjeta_instruccion";
        },

		"back": function(){
            States.storeNamedValue("navegar.cancelar_ingreso_tarjeta", true);
            return "p/close_salir"; 
        },
	}
}