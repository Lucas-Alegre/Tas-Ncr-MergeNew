{
    "base" : include(p/bases/reingreso_pin.json),

    "events" : {
        include(p/chunk/event_back_origen_pin.json),
	
        "validacion_ok": function(){
				var siguiente = States.getStoredValue("navegar.proxima_accion");
				if (siguiente && siguiente === "pagoTTCC") {
					States.storeNamedValue("navegar.proxima_accion", null);
					return "p/pago_ttcc_comms_simulacion";
				}
				if (siguiente && siguiente === "ir_a_pagos_impuestos") {
					States.storeNamedValue("navegar.proxima_accion", null);
					return "p/pago_impuestos_comms_simulacion";
				}

				
				if (siguiente && siguiente === "ir_a_transferencia_terceros") {
					States.storeNamedValue("navegar.proxima_accion", null);
					return "p/transf_comms";
				}else{
					return "p/identificacion_manual_comms_cuentas";
				}
		},

        "validacion_error": "p/close_identificacion_incorrecta",

    }
}