"events" : {

    "cancel": function(){
      if (States.getStoredValue("no_cliente") === true) {
        return "p/close_salir";//"p/status_inservice";
      } else {
        return "p/close_salir";
      }
    },

    "consultas": {
        "call": "p/redireccion_transaccion",
        "events": {
            "validacion_ok": "p/consultas",
            "hardware_error_pin": "p/close_hardware_error",
            "cancel" : "p/close_salir"
        }
    },
        
    "mensajes": "p/pedidos_check_dep",

    "depositoOpcion": function() {
      if (States.getStoredValue("no_cliente") === true) {
        return "p/deposito_tipo_terceros";
      } else {
        return "p/deposito_tipo";
      }
    },
     
    "deposito_terceros": "p/deposito_terceros_check_dep",
    
    "cambio_pin": {
		"call": "p/redireccion_transaccion",
        "events": {
            "validacion_ok":function(){
                States.storeNamedValue("origen_to_back_pin", "cambio_pin");
                States.storeNamedValue("proxima_accion", "cambio_pin");
                return "p/cambio_pin_reingreso_pin";
            },
            "hardware_error_pin": "p/close_hardware_error",
            "cancel" : "p/close_salir"
        }
	},

		"extraccion": {
		    "call": "p/identificacion",
            "events": {
                "identificacion_ok" : "p/selecciona_moneda",
                "hardware_error_pin": "p/close_hardware_error",
                "cancel" : "p/close_salir"
            }
		},

		"transferencia": {
		    "call": "p/redireccion_transaccion",	
            "events": {
                "validacion_ok" : "p/transf_cuenta_origen",
                "hardware_error_pin": "p/close_hardware_error",
                "cancel" : "p/close_salir"
            }
		},

       "pago_ttcc": {
            "call": "p/redireccion_transaccion",	
            "events": {
                "validacion_ok" : "p/pago_ttcc_tipo",
                "hardware_error_pin": "p/close_hardware_error",
                "cancel" : "p/close_salir"
            }
        },

    "pago_impuestos": "p/pago_impuestos_check_dep",

	"entrega_documentacion": "p/entrega_documentacion_check_dep",

    include(p/chunk/event_timeout.json),

}