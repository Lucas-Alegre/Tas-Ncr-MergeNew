"events" : {

    "cancel": "p/close_salir",

    "clear": "p/menu_principal_select", 

    "consultas": {
        "call": "p/identificacion",
        "events": {
            "identificacion_ok" : "p/consultas",
            "hardware_error_pin": "p/close_hardware_error",
            "cancel" : "p/close_salir",
            "clear": "p/menu_principal_select",
        }
    },
        
    "mensajes": "p/pedidos_check_dep",

    "depositoOpcion": function() {
      if (States.getStoredValue("no_cliente") === true) {
        return "p/deposito_tipo_terceros";
      } else {
        console.log("Voy hacia => deposito_tipo");
        return "p/deposito_tipo";
      }
    },
    
    "cambio_pin": {
		    "call": "p/identificacion",
            "events": {
                "identificacion_ok" : "p/cambio_pin1",
                "hardware_error_pin": "p/close_hardware_error",
                "cancel" : "p/close_salir",
                "clear": "p/menu_principal_select",
            }
		},

		"extraccion": {
		    "call": "p/identificacion",
            "events": {
                "identificacion_ok" : "p/selecciona_moneda",
                "hardware_error_pin": "p/close_hardware_error",
                "cancel" : "p/close_salir",
                "clear": "p/menu_principal_select",
            }
		},

		"transferencia": {
		    "call": "p/identificacion",	
            "events": {
                "identificacion_ok" : "p/transf_cuenta_origen",
                "hardware_error_pin": "p/close_hardware_error",
                "cancel" : "p/close_salir",
                "clear": "p/menu_principal_select",
            }
		},

    "pago_ttcc": {
        "call": "p/identificacion",	
        "events": {
            "identificacion_ok" : "p/pago_ttcc_tipo",
            "hardware_error_pin": "p/close_hardware_error",
            "cancel" : "p/close_salir",
            "clear": "p/menu_principal_select",
        }
    },

    "pago_impuestos": "p/pago_impuestos_check_dep",

	"entrega_documentacion": "p/entrega_documentacion_check_dep",

    include(p/chunk/event_timeout.json),

}