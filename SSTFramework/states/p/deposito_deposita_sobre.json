
{
    "base": include(p/bases/buzon_deposita_sobre.json),

    "properties": {
        "printLine": function() {
            var date = new Date();
            var datestr = UserFuns.getDateString(date) + " " + UserFuns.getTimeString(date)
            var line = SSUtil.getLocal("TerminalName", "") + " " + datestr;
            try { 
                line += " " + States.getSequencialNumber("config.numtrx", false);
				if(States.getStoredValue("data.menu_principal").value =="entrega_documentacion") {
					if(States.getStoredValue("deposito_tipo").text =="Entrega Cheque Remoto Valores Negociados") {
						line += " CH REMOTO - VAL NEG";
					} else {
						line += " CH REMOTO - AL COBRO";
					}
				} else {
				    line += " Deposito";
					line += " " + States.getStoredValue("deposito_tipo").text;
				}
				if(States.getStoredValue("data.menu_principal").value =="entrega_documentacion") {
					line += " " + States.getStoredValue("destino_id", "0");
				} else {
					line += " " + States.getStoredValue("customer", "0");
				}
                line += " " + " $" + States.getStoredValue("monto");
            } catch(ex) {}
            return line;
        }
    },

    
    "events": {

        "deposit_ok": function() {
			if(States.getStoredValue("data.menu_principal").value =="entrega_documentacion") {
				return "p/deposito_print_trx";
			} else {
				var tipo = States.getStoredValue("deposito_tipo");            
				if(tipo.value==0) {
					return "p/deposito_comms_confirma";
				} else {
					return "p/deposito_comms_cheques_confirma";
				}
			}
        },
        "deposit_error": "p/close_hardware_error",
        "hardware_error_dep": "p/close_hardware_error", 
        "cancel": "p/menu_principal_select",
        }

}