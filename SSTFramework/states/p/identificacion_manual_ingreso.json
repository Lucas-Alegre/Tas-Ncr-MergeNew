{
    "base" : include(p/bases/ingreso_documento.json),

    "properties": {
        "storename": "customer_id",
    },

	"screens": {

	    "default" : {
			            
	        include(p/chunk/title_transaccion.json),

            "update": function(screen) {
                var tipo = States.getStoredValue("customer_id_type");

                if (tipo === 31) {
                    screen.sub_subtitle_intermedio = {
                        text: "Ingresá tu DNI"
                    };
                } else if (tipo === 35) {
                    screen.sub_subtitle_intermedio = {
                        text: "Ingresá tu C.U.I.L./C.U.I.T./C.D.I."
                    };
                } else {
                    screen.sub_subtitle_intermedio = {
                        text: "Ingresá tu número de cliente<br>y toque continuar"
                    };
                }
            },
    
		}
	},

	"events" : {
	    include(p/chunk/event_timeout.json),

	    "back": "p/identificacion_manual",
        
		"accept": function(){
            States.storeNamedValue("navegar.origen_pin", "identificacion");
            return "p/identificacion_manual_comms";
        },
 
        "reject": function() {
            States.refreshState();
        },
	}
}