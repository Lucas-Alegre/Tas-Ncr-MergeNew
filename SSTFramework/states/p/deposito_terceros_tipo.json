{
    "base": include(p/bases/selecciona_tipo_cuenta.json),

	"screens": {

	    "default" : {

	        include(p/chunk/title_transaccion.json),
    
            "subtitle": {			
                "text" : "Seleccione el tipo de cuenta"
	        },

      }
	},

	"events" : {
	    include(p/chunk/event_timeout.json),
        "cancel": "p/menu_principal_select",
	    "select": "p/deposito_terceros_numero_sucursal",
        "back": function(){
			var tipoAccion = States.getStoredValue("flow.tipo_accion");
			if (tipoAccion === "deposito_tercero") {
				return "p/deposito_tipo_terceros";
			} else {
				return "p/deposito_selector";
			}
		},
	}
}