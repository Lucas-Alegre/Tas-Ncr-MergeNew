{
	"type": "General",

	"screens": {

	    "default" : {

	        "update": function() {
	            var tabla = "";
	            var cuenta = UserFuns.getProduct("cuenta");	         
	            tabla += "<table id='detalle'>";
	            tabla += "<tr><td>" + UserFuns.formatProductName(cuenta) + "</td><td>" + UserFuns.formatProductValue(cuenta) + "</td></tr>";
	            tabla += "</table>";
	            tabla += "<table id='detalle'>";
	            tabla += "<tr><td>CBU:</td><td>" + cuenta.CNU_CBUP1 + "-" + cuenta.CNU_CBUP2 + "</td></tr>";
	            tabla += "</table>";
	            if(cuenta.WNO_CLIE1!=null) {
	                tabla += "<br>"
	                tabla += "<table id='detalle'>";
	                tabla += "<tr><td>Titulares:</td><td></td></tr>";
	                tabla += "<tr><td>" + cuenta.WNO_CLIE1 + "</td><td></td></tr>";
	                if(cuenta.WNO_CLIE2!=null)
	                    tabla += "<tr><td>" + cuenta.WNO_CLIE2 + "</td><td></td></tr>";
	                if(cuenta.WNO_CLIE3!=null)
	                    tabla += "<tr><td>" + cuenta.WNO_CLIE3 + "</td><td></td></tr>";
	                tabla += "</table>";
	            }
	            States.setProperty("detalle", tabla);
	        },
			
            include(p/chunk/title_transaccion.json),

            "subtitle": {
                "text": "Toque CONTINUAR para imprimir la consulta"
            },

             include(p/chunk/nav_cancelar_continuar.json),
    

            "message": { 
                "text": "<%= detalle %>"
            },

		}
	},

	"events" : {
	    include(p/chunk/event_timeout.json),

	    "enter": "p/consulta_cbu_print",
        "cancel": "p/close_salir",
	}
}