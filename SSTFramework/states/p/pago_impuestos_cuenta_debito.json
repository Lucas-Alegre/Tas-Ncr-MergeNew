{
    "base": include(p/bases/selecciona_cuentav2.json),

    "properties": {
        "conceptos": [1, 2],        
        "flags": ["TSEDEBITO" ],
        "monedas": [80],
    },

	"screens": {

	    "default" : {

	        include(p/chunk/title_transaccion.json),

      
            "sub_subtitle": {
                "text": "Seleccione una cuenta donde realizar el débito",
            },

            "nav":{
                include(p/chunk/nav_btn_volver_first.json),
             },

		}
	},
    
	"events" : {
	    include(p/chunk/event_timeout.json),     
        "back": function() {
            sessionStorage["temp.select_from_list.selectAccount"] = 0;  
			if ( States.getStoredValue("seleccion_medio_pago") == true )
				return "p/pago_impuestos";
			else
				return "p/menu_principal_select";
		},
        "sin_opciones": "p/close_sin_opciones",
        "select": function () {
            sessionStorage["temp.select_from_list.selectAccount"] = 0;
            return "p/pago_impuestos_comprobantes";
        },
        "cancel": function () {
            sessionStorage["temp.select_from_list.selectAccount"] = 0;  
            return "p/menu_principal_select";
        },
    }
}