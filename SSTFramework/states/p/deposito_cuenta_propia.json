{
    "base": include(p/bases/selecciona_cuentav2.json),
    
    "properties": {
        "conceptos": [1, 2],
        "flags": ["TSECREEFE", "TSECRECHE" ],
        "monedas": [80],
    },

	"screens": {
	    "default" : {
	        include(p/chunk/title_transaccion.json),
	    }
	},

	"events" : {
	    include(p/chunk/event_timeout.json),
        "sin_opciones": "p/close_sin_opciones",
        "select": function(){
            sessionStorage["temp.select_from_list.selectAccount"] = 0;  
            States.storeNamedValue("navegar.proxima_accion", "deposito_cuenta_propia");
            var tipo = States.getStoredValue("flow.tipo_deposito");
            if(tipo==="efectivo"){
                //States.storeNamedValue("flow.tipo_deposito", null);
                return "cim/check_status";
            }else{
                //States.storeNamedValue("flow.tipo_deposito", null);
                return  "cheque/check_status";
            }
        },
        "back": function () {
            sessionStorage["temp.select_from_list.selectAccount"] = 0;  
            return "p/deposito_selector";
        },
        "cancel": function () {
            sessionStorage["temp.select_from_list.selectAccount"] = 0;  
            return "p/menu_principal_select";
        },
    }
}
