{
    "type": "PinEntry",

    "screens": {


        "default": {

            include(p/chunk/title_transaccion.json),

            "sub_subtitle_intermedio": {
                "text": "Ingresá tu Clave de canales"
            },

            "inputarea": {
                "pin": "true",
            },

            "video": {
                "class": "video_ingreso_pin",
                "src": "<%= SSUtil.readCSS('video_ingreso_pin') %>"
            },


            "nav": {
                "nav0": {
                    "text": "Volver",
                    "event": "back"
                },

            }
        }
    },

	"properties" : {

	
	    "storename": "pinblock",

		"datachanged": function(args) {			
		    return args.slice(0, 12);
		},

		"datapresented": function(args) { 
		    var pin = "";
		    for(var c=0; c<args.length; c++)
		        pin += "&#x25cf;";
		    return pin; 
		},
	
	},
    
    "events": {
        include(p/chunk/event_timeout.json),
    }
}