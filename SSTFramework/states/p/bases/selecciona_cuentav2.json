{
    "type": "General",

    "properties": {
        "storename": "cuenta",
        "storeCallback": function(val) {
            var storename = States.getProperty("storename", "cuenta");
            var detalle = storename + "_detalle";

            var prod = UserFuns.getProduct(storename); 
            if(prod) {
                States.storeNamedValue(detalle, prod);
            } else {
                States.storeNamedValue(detalle, null);
            }
            return val;
        },

        "nav": function() {
            var prod = UserFuns.getProduct(States.getProperty("storename", "cuenta")); 
            if(prod)
                prod = UserFuns.formatProduct(prod, true);
            else
                return null;
            return prod;
        },

        "flags_values": [
            "TSEDEBITO", "TSECREEFE", "TSECRECHE", "TSETRANSF", "TSE_CONSU"
        ],

        "monedas": null,
    },

	"screens": {

	    "default" : {
            
	        "update": function(screen) {				
	            var nombre = States.getStoredValue("customer_name");
	            States.setProperty("nombre_cliente", nombre);
				
	            var conceptos = States.getProperty("conceptos");
	            var flags = States.getProperty("flags");
	            var monedas = States.getProperty("monedas");

				var cuentas = UserFuns.getFilteredProducts(conceptos, flags, monedas);
				
	            var opciones = [];	            
	            
	            for(var c=0; c<cuentas.length; c++) {
					if (cuentas[c] != null) {
						opciones.push({
							text: UserFuns.formatProduct(cuentas[c], true),
							value: c,
						});
					}
				}                   
	            
	            //var orden = ["select0", "select1", "select2", "select3", "select4", "select5"]; //este era el nuevo original funcional para nuevo listado
                var orden = ["select0"];
                UserFuns.selectFromListNamed(screen, opciones, orden, "selectAccount");
	        },
		
            include(p/chunk/title_transaccion.json),

      
            "sub_subtitle": {
                "text": "Bienvenido <%= nombre_cliente %><br>Por favor, seleccione una cuenta",
            },

            include(p/chunk/nav_cancelar_anterior.json),

            
		}
	},
    
	"events" : {

	    include(p/chunk/event_timeout.json),
        "cancel": "p/menu_principal_select",

        "sin_opciones": "p/close_sin_opciones",

        "state_entry": function() {
            sessionStorage["temp.select_from_list.selectAccount"] = 0;
        },

        "mas": function () {
            var key = "temp.select_from_list.selectAccount";
            var pos = parseInt(sessionStorage[key] || "0", 10);
            //pos += 6; // o la cantidad de items por página
            pos += 1;
            sessionStorage[key] = pos;
            States.refreshState();
        },

        "menos": function () {
            var key = "temp.select_from_list.selectAccount";
            var pos = parseInt(sessionStorage[key] || "0", 10);
            //pos -= 6; // mismo valor que arriba
            pos -= 1;
            if (pos < 0) pos = 0;
            sessionStorage[key] = pos;
            States.refreshState();
        },

	}
}