{ 

    "base" : include(p/bases/print.json),

	"screens": { 

	    "receipt": {

	        "name": "sup_consulta_sobres",

			"update": function() { 
			    var total = States.getStoredValue("sup.total");
			    var sobres = States.getStoredValue("sup.status").lpBuffer.wNumOfDeposits;

			      var sobre= "";
			        sobre += "Ultima apertura:" + "\r\n";
			        sobre += "Sobres adentro: " + sobres + "\r\n";
			        sobre += "Aperturas anteriores:" + "\r\n";
			        sobre += "Total sobres: " + total;
			        xfsAudit("Consulta de sobres",sobre); 

			    var receipt = { 
			        "sobres": sobres,
			        "total_sobres": total,
			    };
			    
			    UserFuns.addPrinterHeader(receipt);
			    return receipt;		

			   				 
			}
	    },	
	},	


	"events": { 	
	    "print_ok": "p/sup_menu_select",
	    "hardware_error_ptr": "p/sup_menu_select"
	}

}
