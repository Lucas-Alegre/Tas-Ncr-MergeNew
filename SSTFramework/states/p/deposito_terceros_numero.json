{
    "base": include(p/bases/ingreso_cuenta.json),

    
    "properties": {

        "storename": "cuenta",
        
    },


	"screens": {

	    "default" : {

	        include(p/chunk/title_transaccion.json),
    
            "sub_subtitle_intermedio": {			
                "text" : "Ingrese el número de cuenta"
	        },

            include(p/chunk/nav_all.json),
	    }
	},

	"events" : {
	    "accept": function(){
            States.storeNamedValue("proxima_accion", "deposito_tercero");
            var tipo = States.getStoredValue("tipo_deposito");
            if(tipo==="efectivo"){           
                //States.storeNamedValue("tipo_deposito", null);
                return "cim/check_status";
            }else{
                //States.storeNamedValue("tipo_deposito", null);
                return  "cheque/check_status";
            }
        },
        "back": "p/deposito_terceros_numero_sucursal",
        "cancel": "p/close_salir",

	}
}