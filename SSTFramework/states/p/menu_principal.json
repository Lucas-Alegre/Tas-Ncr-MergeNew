{
	"type": "General",
    
    "properties": {
        
        "storename": "data.menu_principal",
        "nav": function(data) {
            return States.getStoredValue("data.menu_principal").text;
        }
	},

	"screens": {

	    "default" : {
		
			"update": function(screen) {
				if (States.getStoredValue("no_cliente") === true) {
					screen.select.select5.text = "Depósito a terceros";
				} else {
					screen.select.select5.text = "Depósito";
				}

				UserFuns.deleteUnenabledSelects(screen.select, "menu_principal");
				
				UserFuns.reorganizeSelects(screen.select);
			},

			"title": {				
				"text" : "Menú Principal"
			},

            "sub_subtitle": {
                "text": "¿Qué necesitás hacer?"
            },

