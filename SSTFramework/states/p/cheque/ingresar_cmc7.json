ssfw = {

    "base" : include(cheque/base_ipm.json),

    "type" : "Custom",

    "run" : function() {

        SSFramework.displayScreen("espera");

        var items_inserted = Vars.get("items_inserted", []);
        var current_cheque_position = Vars.get("current_cheque_position");
        var codeline = items_inserted[current_cheque_position].codeline;

        if (codeline.indexOf("#") > -1) {
            States.handleEvent("rechazado");
        }

        var inicio = codeline.indexOf("-");
        var fin = codeline.indexOf("d");
        if ((inicio == -1) || (fin == -1)) {
            States.handleEvent("rechazado");
        }
        
        var cmc7 = codeline.substring(inicio+1,fin);
        var placeholder = cmc7.replace(/!/g, '_');
        Vars.set("placeholder",placeholder);
        var digitos_no_reconocidos = cmc7.split("!").length-1;

        if (digitos_no_reconocidos == 0) {
            Vars.set("cmc7",cmc7);
            States.handleEvent("accept");
            return;
        }

        if (digitos_no_reconocidos > 5) {
            States.handleEvent("rechazado");
            return;
        }

        SSFramework.displayScreen("default");
    },

    "properties" : {

        "datachanged": function(args) {
            return args;
        },

        "datapresented": function(args) {
            return args;
        },

        "dataccept": function(args) {
            if (Vars.get("placeholder_modificado").indexOf("_") != -1) {
                return false;
            } else {
                Vars.set("cmc7",Vars.get("placeholder_modificado"));
                return true;
            }
        },
    },

    "screens" : {

        "default": {

            "update" : function(screen) {
                screen.input_cmc7.placeholder = Vars.get("placeholder");
            },

            include(p/chunk/title_transaccion.json),

            "subtitle": {
                "text": "Ingrese los dígitos faltantes (\"_\") del CMC7"
            },

            "cheques" : {},

            "input_cmc7": {
                "placeholder" : ""
            },

            "numkeyboard": {},

            "nav": {
                "nav1": {
                    "text": "Cancelar",
                    "event": "cancel",
                },
                "nav2": {
                    "text": "Borrar",
                    "event": "clear",
                },
                "nav3": {
                    "text": "Confirmar",
                    "event": "enter",
                },
            },
        },

        "espera": {

            include(p/chunk/title_transaccion.json),

            "message" : {
                "text" : "Esperá un momento, por favor <br><div class='spinner'></div></img>"
            },
        },

        "cmc7_invalido": {

            include(p/chunk/title_transaccion.json),
            
            "message": {
                "text": "Cheque rechazado <br> No se pudo leer correctamente el CMC7 <br><br> ¿Desea continuar?",
            },

            "nav": {
                "nav1": {
                    "text": "No",
                    "event": "no",
                },
                "nav3": {
                    "text": "Si",
                    "event": "si",
                },
            },

        },
    },

    "events" : {
        "enter" : function() { 
            States.fireCustomEvent("input.enter", null);
        },
        "clear" : function() { 
            States.fireCustomEvent("input.clear", null);
        },
        "accept" : function() {
            var items_inserted = Vars.get("items_inserted", []);
            var current_cheque_position = Vars.get("current_cheque_position");
            var cmc7 = Vars.get("cmc7");
            items_inserted[current_cheque_position]["cmc7"] = cmc7;
            items_inserted[current_cheque_position].data.bank = cmc7.substring(0,3);
            items_inserted[current_cheque_position].data.branch = cmc7.substring(3,6);
            items_inserted[current_cheque_position].data.zip_code = cmc7.substring(6,10);
            items_inserted[current_cheque_position].data.cheque_number = cmc7.substring(10,18);
            items_inserted[current_cheque_position].data.account = cmc7.substring(18,28);
            Vars.set("items_inserted", items_inserted);
            return "cheque/iterar_cheques"; 
        },
        "rechazado" : function() {
            SSFramework.displayScreen("espera");
            var items_inserted = Vars.get("items_inserted", []);
            var current_cheque_position = Vars.get("current_cheque_position");
            items_inserted[current_cheque_position]["cmc7"] = "";
            items_inserted[current_cheque_position]["banco"] = "";
            items_inserted[current_cheque_position]["monto"] = "";
            items_inserted[current_cheque_position]["fecha"] = "";
            items_inserted[current_cheque_position]["rechazado"] = true;
            Vars.set("items_inserted", items_inserted);
            States.getProperty("setDestination")(Vars.get("current_cheque_position"),0);
        },
        "ipm_set_destination_ok" : function() {
            SSFramework.displayScreen("cmc7_invalido");
        },
        "ipm_set_destination_error" : "cheque/salida_error",
        "si" : "cheque/iterar_cheques",
        "no" : "cheque/devolver_cheques", 
        "cancel" : "cheque/devolver_cheques",
        "timeout" : "cheque/timeout_cheques"
    }
}