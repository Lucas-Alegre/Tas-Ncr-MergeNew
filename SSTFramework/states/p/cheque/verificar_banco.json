ssfw = {

    "base" : include(cheque/base_ipm.json),

    "type" : "General",

    "run" : function() {

        // Si no es Pago TTCC se acepta cualquier cheque
        if (States.getStoredValue("data.menu_principal").value != "pago_ttcc") {
            States.handleEvent("continue");
            return;
        }

        var items_inserted = Vars.get("items_inserted", []);
        var current_cheque_position = Vars.get("current_cheque_position");
        var bank = items_inserted[current_cheque_position].data.bank;

        var entity = Vars.get("entidad");
        var codigo_cheque_banco = "";

        switch (entity) {
            case "bersa":
                codigo_cheque_banco = "386"; 
                break;
            case "santacruz":
                codigo_cheque_banco = "086"; 
                break;
            case "sanjuan":
                codigo_cheque_banco = "045"; 
                break;
            default:
                codigo_cheque_banco = "";
                break;
        }

        if (bank == codigo_cheque_banco) {
            States.handleEvent("continue");
        } else {
            States.handleEvent("rechazado");
        }

    },

    "screens" : {

        "default": {

            include(p/chunk/title_transaccion.json),

            "message" : {
                "text" : "Esperá un momento, por favor <br><div class='spinner'></div></img>"
            },
        },

        "banco_invalido": {

            include(p/chunk/title_transaccion.json),
            
            "message": {
                "text": "Cheque rechazado <br> El cheque no pertenece al Banco <br><br> ¿Desea continuar?",
            },

            "nav": {
                "nav1": {
                    "text": "No",
                    "event": "no",
                },
                "nav3": {
                    "text": "Si",
                    "event": "si",
                },
            },

        },

    },

	"events" : {
        "continue" : function() {
            var items_inserted = Vars.get("items_inserted", []);
            var current_cheque_position = Vars.get("current_cheque_position");
            items_inserted[current_cheque_position]["banco"] = items_inserted[current_cheque_position].data.bank;
            Vars.set("items_inserted", items_inserted);
            return "cheque/iterar_cheques"; 
		},
        "rechazado" : function() {
            var items_inserted = Vars.get("items_inserted", []);
            var current_cheque_position = Vars.get("current_cheque_position");
            items_inserted[current_cheque_position]["cmc7"] = "";
            items_inserted[current_cheque_position]["banco"] = "";
            items_inserted[current_cheque_position]["monto"] = "";
            items_inserted[current_cheque_position]["fecha"] = "";
            items_inserted[current_cheque_position]["rechazado"] = true;
            Vars.set("items_inserted", items_inserted);
            States.getProperty("setDestination")(Vars.get("current_cheque_position"),0);
        },
        "ipm_set_destination_ok" : function() {
            SSFramework.displayScreen("banco_invalido");
        },
        "ipm_set_destination_error" : "cheque/salida_error",
        "si" : "cheque/iterar_cheques",
        "no" : "cheque/devolver_cheques", 
        "timeout" : "cheque/timeout_cheques"
 	}
}