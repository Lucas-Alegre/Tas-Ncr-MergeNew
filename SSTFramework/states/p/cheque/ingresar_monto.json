ssfw = {

    "base" : include(cheque/base_ipm.json),

    "type" : "General",

	"properties" : {

        "accept_zero": "0",

        "storename": "monto",

        "decimales": "2",

        "datachanged": function(args) {         
            return args.slice(0, 12);
        },

        "datapresented": function(args) { 
            var div = 1;
            
            var decimales = parseInt(States.getProperty("decimales"));
            for(var c=0; c<decimales; c++)
                div *= 10;
            return "$ " + SSUtil.formatNumber((parseFloat(args)/div).toFixed(decimales), decimales);
        },

        "dataccept": function(args) {
            
            if (parseInt(States.getProperty("accept_zero")) != 0) {
                if(args.length<1) {
                    args = "0";
                }
            }

            if (args.length < 1) {
                return false;
            }

            var store = States.getProperty("storename");
            var data = States.getStoredValue(store);
            var decimales = parseInt(States.getProperty("decimales"));
            var div = 1;

            for(var c=0; c<decimales; c++) {
                div *= 10;
            }

            var val = (parseFloat(data)/div);
            if (parseInt(States.getProperty("accept_zero")) == 0) {
                if (val <= 0) {
                    return false;
                }
            }

            var res = val.toFixed(decimales);           
            States.storeNamedValue(store, res.toString());

            return true;
        },
	},

    "screens" : {

        "default": {

            include(p/chunk/title_transaccion.json),

            "subtitle": {
                "text": "Ingrese el monto del cheque"
            },

            "cheques" : {},

            "inputarea": {},

            "numkeyboard": {},

            "nav": {
                "nav1": {
                    "text": "Cancelar",
                    "event": "cancel",
                },
                "nav2": {
                    "text": "Borrar",
                    "event": "clear",
                },
                "nav3": {
                    "text": "Confirmar",
                    "event": "enter",
                },
            },
        },

        "cheque_aceptado": {

            include(p/chunk/title_transaccion.json),
            
            "message": {
                "text": "Cheque aceptado",
            },

        },
    },

	"events" : {
        "enter" : function() { 
            States.fireCustomEvent("input.enter", null);
        },
        "clear" : function() { 
            States.fireCustomEvent("input.clear", null);
        },
        "accept" : function() {
            SSFramework.displayScreen("cheque_aceptado");
            window.setTimeout(function() {
                var items_inserted = Vars.get("items_inserted", []);
                var current_cheque_position = Vars.get("current_cheque_position");
                items_inserted[current_cheque_position]["monto"] = Vars.get("monto");
                Vars.set("items_inserted", items_inserted);
                States.handleEvent("cheque_aceptado"); 
            }, 2000);
		},
        "cheque_aceptado" : "cheque/iterar_cheques",
        "cancel" : "cheque/devolver_cheques",
        "timeout" : "cheque/timeout_cheques"
 	}
}