{
    "base": include(p/bases/selecciona_cuentav2.json),

    "properties": {
        "storename": "tarjeta_pago",        
        "conceptos": [25], 
        "monedas": [80],
    },

    
	"screens": {
                
	    "default" : {

	        include(p/chunk/title_transaccion.json),

            "sub_subtitle": {
                "text": "Seleccione la tarjeta que desea pagar",
            },

            include(p/chunk/nav_cancelar_anterior.json),

            "nav": {							    
                "nav1" : {
                    "text": "Por resumen de cuenta",
					"event": "resumen",
                    "value": "resumen",
                }
            },
		}
	},
    
	"events" : {
	    include(p/chunk/event_timeout.json),

	    "resumen" : "p/pago_ttcc_resumen_tipo_ingreso",

        "back": function() {
            sessionStorage["temp.select_from_list.selectAccount"] = 0;  
			return "p/pago_ttcc_tipo_pago";
		},
        "sin_opciones": "p/close_sin_opciones",
        "select": function () {
            sessionStorage["temp.select_from_list.selectAccount"] = 0;
            return "p/pago_ttcc_tipo_medio";
        },
        "cancel": function () {
            sessionStorage["temp.select_from_list.selectAccount"] = 0;  
            return "p/menu_principal_select";
        },

	}
}