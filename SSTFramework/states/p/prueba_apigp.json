    "run": function() {

        //var url = "http://bsfactappwd1.nbsf.com.ar:9003/tas/";
        var url = "http://172.21.222.181:8070/tas";
        

        $.ajax({
            url: url,
            method: "GET",
            headers: {                 
                "dpb-sucursal": "0",
                "dpb-terminal": "3570",
                "dpb-operacion": "125156",
                "dpb-tipo_terminal": "T600",
                "dpb-operador": "TASUNI"
            },
            timeout: 7000,

            // Si sale bien
            success: function (data, textStatus, xhr) {
                console.log("[GET OK API-GP]", xhr.status, data);
                States.storeNamedValue("test.apigp_response", { status: xhr.status, data: data });
               //States.handleEvent("yes");
            },

            // Si sale error
            error: function (xhr, textStatus, errorThrown) {
                console.error("[GET ERROR API-GP]", textStatus, errorThrown, xhr && xhr.responseText);
                States.storeNamedValue("test.apigp_response", { status: xhr.status, error: errorThrown });
                //States.handleEvent("yes");
            }
        });
