{
    "base": include(p/bases/selecciona_cuenta.json),

    "properties": {
        "storename": "cuenta_debito",
        "conceptos": [1, 2],  
        "flags": ["TSEDEBITO" ],
        "monedas": [80],
    },

	"screens": {

	    "default" : {

	        include(p/chunk/title_transaccion.json),

      
            "sub_subtitle": {
                "text": "Seleccione una cuenta donde realizar el débito",
            },

            "nav":{
                include(p/chunk/nav_btn_volver_first.json),
            }

		}
	},
    
	"events" : {
	    include(p/chunk/event_timeout.json),

        
        "sin_opciones": "p/close_sin_opciones",

        "select": function(){
            States.storeNamedValue("pago_ttcc.importe", null);
            return "p/pago_ttcc_confirma";
        },

        "cancel": "p/close_salir",

        "back": function(){
            var tipoIngreso = States.getStoredValue("pago_ttcc.importe");
            if(tipoIngreso == "otro_monto"){
                return "p/pago_ttcc_monto";
            }else{
                return "p/pago_ttcc_tipo_pago";
            }
        }

    }
}