{
	"type": "General",

	"screens": {

	    "default" : {

	        "update": function() {
	
	                var tabla = "";
	                var cuenta = UserFuns.getProduct("cuenta");
	                tabla += "<table id='detalle'>";
                    tabla += "<tbody>";
                    tabla += "<tr><td>Número:</td><td>" + UserFuns.formatProductValue(cuenta) + "</td></tr>";
                    tabla += "<tr><td>Cuenta:</td><td>" + cuenta.TNUCUENTA + "</td></tr>";
                    tabla += "<tr><td>Total resumen $:</td><td>" + UserFuns.formatMonto(cuenta.CSA_DISPO) + "</td></tr>";
                    tabla += "<tr><td>Pago mínimo $:</td><td>" + UserFuns.formatMonto(cuenta.CSA_CONFO) + "</td></tr>";
                    tabla += "<tr><td>Total a pagar U$S:</td><td>" + UserFuns.formatMonto(cuenta.CSAEFEHOY) + "</td></tr>";
                    tabla += "<tr><td>Vencimiento Resumen:</td><td>" + UserFuns.formatFecha(cuenta.FFE_VENCI) + "</td></tr>";
                    tabla += "<tr><td>Fecha de cierre:</td><td>" + UserFuns.formatFecha(cuenta.SFECIERRE) + "</td></tr>";
                    tabla += "</tbody>";
                    tabla += "</table>";
                    States.setProperty("detalle", tabla);
                },
			
            include(p/chunk/title_transaccion.json),

            "sub_subtitle_chico": {
                "text": "Toque continuar para imprimir la consulta"
            },

            include(p/chunk/nav_volver_continuar.json),
    

            "table_data": { 
                "text": "<%= detalle %>"
            },

		}
	},

	"events" : {
	    include(p/chunk/event_timeout.json),

	    "enter": "p/consulta_tarjetas_print",
        "back": "p/consultas",
        "cancel": "p/menu_principal_select",
        }
}