{
    
    "base" : include(p/bases/selecciona_cuentav2.json),

    "properties": {
        "storename": "cuenta",
        "conceptos": [1, 2],
        "monedas": [80],
    },

    "screens": {

                
        "default" : {            
    
            include(p/chunk/title_transaccion.json),
    
            "sub_subtitle": {
                "text": "Por favor, seleccione la cuenta de donde realizar los débitos",
            },
        }
    },

    "events": {
        include(p/chunk/event_timeout.json),
                
        "sin_opciones": "p/close_sin_opciones",

        "back": function() {
            sessionStorage["temp.select_from_list.selectAccount"] = 0;  
			return "p/pago_ttcc_pregunta_adesion";
		},
        "select": function () {
            sessionStorage["temp.select_from_list.selectAccount"] = 0;
            return "p/pago_ttcc_confirma_adesion";
        },
        "cancel": function () {
            sessionStorage["temp.select_from_list.selectAccount"] = 0;  
            return "p/menu_principal_select";
        },

    },

}   