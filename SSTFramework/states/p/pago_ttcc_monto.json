{
    
    "base" : include(p/bases/ingreso_monto.json),

    "properties": {

        "decimales": "2",

        "storename": "monto",

    },

    "screens": {
                        
        "default" : {            
                
            include(p/chunk/title_transaccion.json),
    
            "subtitle": {
                "text": "Por favor, ingrese el monto a pagar en $<br>Luego toque CONTINUAR",
                },

            include(p/chunk/nav_all.json),
    
        }
    },

    "events": {
        include(p/chunk/event_timeout.json),

        "accept": function(){
            if (Vars.get("medio_pago_tarjeta") == "cheque") {
                return "p/pago_ttcc_confirma";
            } else {
                return "p/pago_ttcc_cuenta_debito";
            }
        },

        "cancel": "p/close_salir",
        "back": "p/pago_ttcc_tipo_medio",
    },

}   