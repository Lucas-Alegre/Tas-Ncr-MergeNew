{
    
    "base" : include(p/bases/ingreso_monto.json),

    "properties": {

        "decimales": "2",

        "storename": "monto",

    },

    "screens": {
                        
        "default" : {            
                
            include(p/chunk/title_transaccion.json),
    
            "sub_subtitle_intermedio": {
                "text": "Por favor, ingrese el monto a pagar en $<br>Luego toque continuar",
                },

            include(p/chunk/nav_all.json),
    
        }
    },

    "events": {
        include(p/chunk/event_timeout.json),

        "accept": function(){
            if (Vars.get("medio_pago_tarjeta") == "cheque") {
                return "p/pago_ttcc_confirma";
            } else {
                States.storeNamedValue("pago_ttcc.importe", "otro_monto");
                return "p/pago_ttcc_cuenta_debito";
            }
        },

        "cancel": "p/close_salir",

        "back": function(){
            States.storeNamedValue("pago_ttcc.importe", null);
            var tipoIngreso = States.getStoredValue("pago_ttcc.tipo_ingreso");
            if(tipoIngreso == "seleccionoCuentas"){
                return "p/pago_ttcc_tipo_pago";//return "p/pago_ttcc_tipo_medio";
            }else if(tipoIngreso == "ingreso_resumen"){
                return "p/pago_ttcc_resumen_tipo_ingreso";
            }
        },
    },

}   