{
    "type": "Custom",

"run": function(statedata) {
    var medio = States.getStoredValue("medio_pago"); 
    if(medio=="debito") {
        return SSFramework.displayScreen(statedata.screens.default);
    } else {
        States.handleEvent("enter");
    };
},

	"screens": {

	    "default" : {

	    	
            include(p/chunk/title_transaccion.json),

            /*"sub_subtitle_cheque": {
                "text": "Diferencia de importes",
                "class": "sub-subtitle-cheque-impuestos",
            },*/ //No hace falta este pequeño texto


            "message": { 
                "text": "En caso de diferir el importe por mi ingresado con el correspondiente a la cancelacion del impuesto/servicio que involucra esta operación, AUTORIZO al banco a debitar de mi cuenta la diferencia entre el importe consignado y el que corresponde abonar por el impuesto/servicio respectivo."
            },

            include(p/chunk/nav_cancelar_continuar.json),

		}
	},

	"events" : {
	    include(p/chunk/event_timeout.json),
	    "enter": "p/pago_impuestos_confirma",
        "cancel": "p/menu_principal_select",
    }
}