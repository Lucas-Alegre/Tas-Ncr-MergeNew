{
	"type": "General",

	"screens": {

	    "default" : {
            
	        "update": function() {
	            var tabla = "";
	            var cuenta = UserFuns.getProduct("cuenta");
	            tabla += "<table id='detalle'>";
				tabla += "<tbody>";
	            tabla += "<tr><td>" + UserFuns.formatProductName(cuenta) + "</td><td>" + UserFuns.formatProductValue(cuenta) + "</td></tr>";
	            tabla += "<tr><td>Saldo Operativo: </td><td>" + UserFuns.formatMonto(cuenta.CSA_DISPO) + "</td></tr>";
	            tabla += "<tr><td>Saldo a Conformar: </td><td>" + UserFuns.formatMonto(cuenta.CSA_CONFO) + "</td></tr>";
	            tabla += "<tr><td>Saldo Contable: </td><td>" + UserFuns.formatMonto(cuenta.CSAEFEHOY) + "</td></tr>";
	            tabla += "<tr><td>Saldo 48hs:</td><td>" + UserFuns.formatMonto(cuenta.CSAFLOH2) + "</td></tr>";
	            tabla += "<tr><td>Dep. Cheque a Conf:</td><td>" + UserFuns.formatMonto(cuenta.CSAFLOH1) + "</td></tr>";
	            tabla += "<tr><td>Depósito a Conf.:</td><td>" + UserFuns.formatMonto(cuenta.CSAFLOE1) + "</td></tr>";
	            tabla += "</tbody>";
				tabla += "<tfoot>";
	            tabla += "<b>** Se imprimieron " + States.getStoredValue("comms.movimientos") + " movimientos **</b>";
	            tabla += "</tfoot>";
				tabla += "</table>";
				States.setProperty("detalle", tabla);
	        },
			
	        
            include(p/chunk/title_transaccion.json),


            "sub_subtitle_chico": {
                "text": "Toque continuar para seguir operando"
            },
    
            "table_data": { 
                "text": "<%= detalle %>"
            },

			include(p/chunk/nav_volver_continuar.json),

		}
	},

	"events" : {
	    include(p/chunk/event_timeout.json),

	    "enter": "p/deposito_pregunta_otra",
        "back": "p/consultas",
        "cancel": "p/menu_principal_select",
	}
}