{
    
    "base" : include(p/bases/selecciona_cuenta.json),

    "properties": {
        "storename": "cuenta_destino",
        "conceptos": [1, 2],
        "monedas": [80],
    },

    "screens": {

                
        "default" : {            
    
            include(p/chunk/title_transaccion.json),
    
            "sub_subtitle": {
                "text": "Por favor, seleccione la cuenta destino",
            },
        }
    },

    "events": {
        include(p/chunk/event_timeout.json),
                
        "sin_opciones": "p/close_sin_opciones",
        
        "cancel": "p/close_salir",

        "select": function () {
            delete sessionStorage["entered.selectAccount"];
            delete sessionStorage["temp.select_from_list.selectAccount"];
            States.storeNamedValue("flujo_transferencia", "propia");
            return "p/transf_ingreso_monto";
        },

        "back": function () {
            delete sessionStorage["entered.selectAccount"];
            delete sessionStorage["temp.select_from_list.selectAccount"];
            return "p/transf_cuenta_destino_tipo";
        },


    },

}   