{
    
    "base" : include(p/bases/selecciona_cuentav2.json),

    "properties": {
        "storename": "cuenta_destino",
        "conceptos": [1, 2],
        "monedas": [80],
    },

    "screens": {

                
        "default" : {            
    
            include(p/chunk/title_transaccion.json),
    
            "sub_subtitle": {
                "text": "Por favor, seleccione la cuenta destino",
            },
        }
    },

    "events": {
        include(p/chunk/event_timeout.json),

        "back": function() {
            sessionStorage["temp.select_from_list.selectAccount"] = 0;  
			return "p/transf_cuenta_destino_tipo";
		},
        "sin_opciones": "p/close_sin_opciones",
        "select": function () {
            sessionStorage["temp.select_from_list.selectAccount"] = 0;
            return "p/transf_ingreso_monto";
        },
        "cancel": function () {
            sessionStorage["temp.select_from_list.selectAccount"] = 0;  
            return "p/menu_principal_select";
        },


    },

}   