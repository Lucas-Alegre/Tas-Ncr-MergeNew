{
    "type": "Custom",

    "run": function(state) {

        const estaIdentificado = SSUtil.getLocal("identified") === true;
        const esNoCliente = States.getStoredValue("no_cliente") === true;

        if (estaIdentificado || esNoCliente) {
          console.log("Pasando validación por identificado o no_cliente");
          States.handleEvent("identified");
        } else {
          console.log("Usuario no identificado, redirigiendo a identificación");
          States.handleEvent("not_identified");
        }

    },

    "events": {
        "identified": function() {
            States.handleEvent("identificacion_ok");   
        },

        "not_identified": "p/identificacion_start",    
    }
}