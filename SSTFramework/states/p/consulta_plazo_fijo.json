{
	"type": "General",

	"screens": {

	    "default" : {

	        "update": function() {
	                var tabla = "";
	                var cuenta = UserFuns.getProduct("cuenta");	          
                    tabla += "<table id='detalle'>";
                    tabla += "<tbody>";
                    tabla += "<tr><td>Nro. Certificado:</td><td>" + UserFuns.formatProductValue(cuenta) + "</td></tr>";
                    tabla += "<tr><td>Moneda: </td><td>" + UserFuns.findCText(cuenta.ACO_MONED) + "</td></tr>";
                    tabla += "<tr><td>Fecha venc.:</td><td>" + UserFuns.formatFecha(cuenta.FFE_VENCI) + "</td></tr>";
                    tabla += "<tr><td>Capital: </td><td>" + UserFuns.formatMonto(cuenta.CSA_DISPO) + "</td></tr>";
                    tabla += "<tr><td>Interés: </td><td>" + UserFuns.formatMonto(cuenta.CSA_CONFO) + "</td></tr>";
                    tabla += "<tr><td>Neto a cobrar:</td><td>" + UserFuns.formatMonto(cuenta.CSAEFEHOY) + "</td></tr>";
                    tabla += "</tbody>";
                    tabla += "</table>";
                    States.setProperty("detalle", tabla);
                },
			
            include(p/chunk/title_transaccion.json),

            "sub_subtitle_chico": {
                "text": "Toque continuar para imprimir la consulta"
            },

            include(p/chunk/nav_volver_continuar.json),
    
            "table_data": { 
                "text": "<%= detalle %>"
            },

		}
	},

	"events" : {
	    include(p/chunk/event_timeout.json),

	    "enter": "p/consulta_plazo_fijo_print",
        "back": "p/consultas",
	}
}