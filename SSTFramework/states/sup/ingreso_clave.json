            "title": {			
                "text" : "Menú Supervisor V {0}"
            },

            "subtitle": {
                "text" : "Ingrese la clave de supervisor y toque continuar"
            },

            "numkeyboard": {},
        
            "inputarea": {},
        
            "nav": {
                "nav0": {
                    "text": "Cancelar",
                    "event": "cancel"
                },

                "nav1": {
                    "text": "Anterior",
                    "event": "back"
                },

                "nav2": {
                    "text": "Borrar",
