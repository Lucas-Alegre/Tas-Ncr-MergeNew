    "properties": {
        "storename": "customer_id",

        "datachanged": function(args) {			
            return args.slice(-12);
        },

		"datapresented": function(args) { 
		    return SSUtil.formatNumber(parseInt(args, 10), 0);
		},
    },

	"events" : {
	    "cancel": "return",

	    "back": "p/identificacion_manual",
        
		"enter": function() { 
		    States.fireCustomEvent("input.enter", null);
		},

        "clear": function() { 
            States.fireCustomEvent("input.clear", null);
        },

		"accept": "p/identificacion_pin",
		}
}
